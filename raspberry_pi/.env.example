# Environment Variables for Smart Agricultural System
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to version control!

# Perenual Plant API Key
# Get your key at: https://perenual.com/user/developer
PERENUAL_API_KEY = your_perenual_api_key_here

# OpenWeatherMap API Key (for weather predictions)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY = your_openweathermap_api_key_here

# Dashboard Server IP (for telemetry)
# Set this to the IP of the machine running your dashboard
DASHBOARD_SERVER_IP = 127.0.0.1
